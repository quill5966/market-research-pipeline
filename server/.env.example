# ──────────────────────────────────────────────────
# Market Research Pipeline — Server Configuration
# ──────────────────────────────────────────────────
# Server-level config only. Per-run parameters (domain, search terms,
# include/exclude domains) are submitted via the UI form.

# ── Required: API Keys ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# ── Required: App passcode ──────────────────────
# Shared secret that gates the UI and API. Anyone with this string can run the
# pipeline (and spend Anthropic/Tavily credits), so use ≥16 random chars and
# rotate it if it leaks. Sent by the client as: Authorization: Bearer <passcode>
APP_PASSCODE=change-me

# ── Optional: LLM Settings for testing─────────────────────
# MODEL=claude-sonnet-4-6
# TOKEN_BUDGET=200000
# Smaller/cheaper model used by the "Suggest search terms" button on the
# New Run screen. Must have an entry in MODEL_PRICING in token_tracker.py.
# SUGGESTION_MODEL=claude-haiku-4-5-20251001

# ── Optional: Output ───────────────────────────
# OUTPUT_DIR=output
# LOG_DIR=logs

# ── Optional: Concurrency ──────────────────────
# Max simultaneously-running pipeline runs across the server (default 3).
# MAX_CONCURRENT_RUNS=3
