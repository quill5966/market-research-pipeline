# ──────────────────────────────────────────────────
# Market Research Pipeline — Server Configuration
# ──────────────────────────────────────────────────
# Server-level config only. Per-run parameters (domain, search terms,
# include/exclude domains) are submitted via the UI form.

# ── Required: API Keys ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# ── Optional: LLM Settings ─────────────────────
# MODEL=claude-sonnet-4-6
# TOKEN_BUDGET=50000

# ── Optional: Output ───────────────────────────
# OUTPUT_DIR=output
# LOG_DIR=logs
